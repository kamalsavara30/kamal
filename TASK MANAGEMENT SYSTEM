<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TaskFlow | Task Management System</title>
<style>
:root{
    --bg:#06101d;
    --bg2:#0a1728;
    --panel:rgba(14,28,48,.78);
    --panel2:rgba(18,36,60,.68);
    --border:rgba(148,190,255,.15);
    --text:#f4f8ff;
    --muted:#9db0c8;
    --blue:#4da3ff;
    --cyan:#00e5ff;
    --purple:#9568ff;
    --green:#27df8b;
    --orange:#ffb84d;
    --red:#ff5d6c;
    --shadow:0 24px 70px rgba(0,0,0,.35);
    --radius:22px;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{
    font-family:Inter,Segoe UI,Arial,sans-serif;
    background:
      radial-gradient(circle at 10% 10%,rgba(77,163,255,.15),transparent 30%),
      radial-gradient(circle at 90% 20%,rgba(149,104,255,.14),transparent 30%),
      linear-gradient(135deg,var(--bg),var(--bg2));
    color:var(--text);
    min-height:100vh;
}
button,input,select,textarea{font:inherit}
button{cursor:pointer}
.hidden{display:none!important}
.glass{
    background:var(--panel);
    border:1px solid var(--border);
    box-shadow:var(--shadow);
    backdrop-filter:blur(18px);
}
.page{min-height:100vh}

/* FRONT PAGE */
#frontPage{
    min-height:100vh;
    position:relative;
    overflow:hidden;
}
.grid-bg{
    position:absolute;inset:0;pointer-events:none;opacity:.25;
    background-image:
      linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),
      linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px);
    background-size:48px 48px;
    mask-image:linear-gradient(to bottom,black,transparent);
}
.navbar{
    width:min(1180px,92%);
    margin:auto;
    padding:24px 0;
    display:flex;
    align-items:center;
    justify-content:space-between;
    position:relative;
    z-index:2;
}
.brand{
    display:flex;align-items:center;gap:12px;
    font-size:22px;font-weight:900;letter-spacing:.3px;
}
.brand-mark{
    width:42px;height:42px;border-radius:14px;
    display:grid;place-items:center;
    background:linear-gradient(135deg,var(--blue),var(--purple));
    box-shadow:0 12px 35px rgba(77,163,255,.25);
    font-size:22px;
}
.nav-actions{display:flex;gap:10px}
.btn{
    border:1px solid var(--border);
    color:var(--text);
    background:rgba(255,255,255,.05);
    padding:12px 18px;border-radius:12px;
    font-weight:800;transition:.2s;
}
.btn:hover{transform:translateY(-2px);border-color:rgba(77,163,255,.5)}
.btn-primary{
    background:linear-gradient(135deg,var(--blue),var(--purple));
    border:none;
}
.hero{
    width:min(1180px,92%);
    margin:0 auto;
    min-height:calc(100vh - 90px);
    display:grid;
    grid-template-columns:1.08fr .92fr;
    gap:50px;
    align-items:center;
    position:relative;
    z-index:1;
}
.badge{
    display:inline-flex;gap:8px;align-items:center;
    padding:8px 13px;border-radius:30px;
    border:1px solid rgba(77,163,255,.25);
    background:rgba(77,163,255,.08);
    color:#b8dcff;font-weight:800;font-size:13px;
}
.hero h1{
    margin-top:20px;
    font-size:clamp(44px,6vw,78px);
    line-height:.98;
    letter-spacing:-3px;
}
.gradient-text{
    background:linear-gradient(90deg,#fff,var(--blue),#b98dff);
    -webkit-background-clip:text;background-clip:text;color:transparent;
}
.hero p{
    color:var(--muted);font-size:18px;line-height:1.8;
    max-width:650px;margin:25px 0;
}
.hero-buttons{display:flex;gap:12px;flex-wrap:wrap}
.hero-card{
    border-radius:28px;padding:24px;
    transform:rotate(1deg);
}
.mock-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}
.mock-title{font-weight:900}
.dot{width:10px;height:10px;border-radius:50%;background:var(--green);box-shadow:0 0 18px var(--green)}
.mock-stats{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
.mini-stat{padding:18px;border-radius:18px;background:rgba(255,255,255,.045);border:1px solid var(--border)}
.mini-stat b{font-size:28px;display:block}
.mini-stat span{color:var(--muted);font-size:12px}
.mock-progress{margin-top:14px;padding:18px;border-radius:18px;background:rgba(255,255,255,.04)}
.progress-track{height:9px;background:#14253b;border-radius:20px;overflow:hidden;margin-top:12px}
.progress-fill{height:100%;width:74%;background:linear-gradient(90deg,var(--blue),var(--cyan));border-radius:20px}
.features{
    width:min(1180px,92%);margin:-30px auto 80px;
    position:relative;z-index:2;
    display:grid;grid-template-columns:repeat(3,1fr);gap:16px;
}
.feature{padding:22px;border-radius:20px}
.feature-icon{font-size:27px;margin-bottom:12px}
.feature h3{font-size:16px;margin-bottom:7px}
.feature p{font-size:13px;line-height:1.6;color:var(--muted)}

/* AUTH */
#authPage{
    min-height:100vh;
    display:none;
    place-items:center;
    padding:30px;
    position:relative;
    overflow:hidden;
}
.auth-wrap{
    width:min(1000px,100%);
    display:grid;
    grid-template-columns:1fr 1fr;
    border-radius:28px;overflow:hidden;
}
.auth-info{
    padding:50px;
    background:
      radial-gradient(circle at 10% 20%,rgba(77,163,255,.18),transparent 35%),
      linear-gradient(145deg,rgba(13,31,53,.98),rgba(9,19,34,.98));
}
.auth-info h2{font-size:38px;line-height:1.05;margin:22px 0 14px}
.auth-info p{color:var(--muted);line-height:1.7}
.auth-list{margin-top:28px;display:grid;gap:13px}
.auth-list div{display:flex;gap:10px;color:#cbd9eb}
.check{color:var(--green)}
.auth-form{padding:50px;background:rgba(9,18,31,.97)}
.auth-form h2{font-size:28px;margin-bottom:7px}
.sub{color:var(--muted);font-size:13px;margin-bottom:25px}
.form-group{margin-bottom:16px}
label{display:block;font-size:13px;font-weight:800;margin-bottom:8px;color:#cbd9eb}
input,select,textarea{
    width:100%;border:1px solid var(--border);
    background:rgba(255,255,255,.045);color:var(--text);
    border-radius:12px;padding:13px 14px;outline:none;
}
input:focus,select:focus,textarea:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(77,163,255,.1)}
.password-box{position:relative}
.password-box button{
    position:absolute;right:8px;top:7px;border:0;background:none;color:var(--muted);padding:7px
}
.auth-row{display:flex;justify-content:space-between;align-items:center;font-size:12px;color:var(--muted);margin:5px 0 18px}
.auth-row label{margin:0;font-weight:500;display:flex;gap:7px;align-items:center}
.auth-row input{width:auto}
.link{color:#85c5ff;cursor:pointer}
.full-btn{width:100%;padding:14px;border-radius:13px}
.demo{
    margin-top:16px;padding:13px;border-radius:13px;
    background:rgba(77,163,255,.06);border:1px dashed rgba(77,163,255,.28);
    color:var(--muted);font-size:12px;line-height:1.6;
}
.error{color:#ff9ba5;font-size:12px;min-height:18px;margin:8px 0}

/* DASHBOARD */
#appPage{display:none;min-height:100vh}
.sidebar{
    width:260px;position:fixed;left:0;top:0;bottom:0;
    background:rgba(5,14,25,.94);border-right:1px solid var(--border);
    padding:22px 16px;z-index:20;
}
.side-brand{display:flex;align-items:center;gap:10px;padding:6px 8px 25px;font-weight:900;font-size:21px}
.side-nav{display:grid;gap:7px}
.side-nav button{
    width:100%;border:1px solid transparent;background:transparent;color:var(--muted);
    padding:12px;border-radius:12px;text-align:left;display:flex;gap:11px;align-items:center;font-weight:800;
}
.side-nav button:hover,.side-nav button.active{background:rgba(77,163,255,.09);color:#fff;border-color:rgba(77,163,255,.12)}
.nav-icon{width:26px;text-align:center}
.profile{
    position:absolute;left:16px;right:16px;bottom:18px;
    border-top:1px solid var(--border);padding-top:15px;
    display:flex;align-items:center;gap:10px;
}
.avatar{width:42px;height:42px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(135deg,var(--blue),var(--purple));font-weight:900}
.profile-name{font-size:13px;font-weight:900}
.profile-role{font-size:11px;color:var(--muted);margin-top:3px}
.main{margin-left:260px;padding:28px;min-height:100vh}
.topbar{display:flex;justify-content:space-between;align-items:center;gap:15px;margin-bottom:25px}
.page-title h1{font-size:29px}
.page-title p{color:var(--muted);font-size:13px;margin-top:5px}
.top-actions{display:flex;gap:8px}
.content-section{display:none}
.content-section.active{display:block}
.welcome{
    border-radius:24px;padding:28px;margin-bottom:18px;
    background:
      radial-gradient(circle at 90% 10%,rgba(149,104,255,.2),transparent 30%),
      linear-gradient(135deg,rgba(20,46,78,.85),rgba(12,25,44,.85));
}
.welcome h2{font-size:27px;margin-bottom:8px}
.welcome p{color:var(--muted);max-width:720px;line-height:1.6}
.stats-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin:18px 0}
.stat{padding:18px;border-radius:18px}
.stat small{color:var(--muted);font-size:11px}
.stat strong{display:block;font-size:27px;margin-top:8px}
.stat.blue{border-left:3px solid var(--blue)}
.stat.orange{border-left:3px solid var(--orange)}
.stat.purple{border-left:3px solid var(--purple)}
.stat.green{border-left:3px solid var(--green)}
.stat.red{border-left:3px solid var(--red)}
.dashboard-grid{display:grid;grid-template-columns:1.35fr .65fr;gap:15px}
.panel{border-radius:20px;padding:20px}
.panel-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:15px}
.panel-head h3{font-size:16px}
.chart{height:240px;display:flex;align-items:end;gap:12px;padding:15px 5px}
.bar-wrap{flex:1;height:100%;display:flex;flex-direction:column;justify-content:end;align-items:center;gap:7px}
.bar{width:100%;max-width:45px;border-radius:9px 9px 3px 3px;background:linear-gradient(180deg,var(--cyan),var(--blue));min-height:8px}
.bar-wrap span{font-size:10px;color:var(--muted)}
.progress-big{height:12px;background:#14263d;border-radius:20px;overflow:hidden;margin:15px 0}
.progress-big div{height:100%;background:linear-gradient(90deg,var(--blue),var(--purple));border-radius:20px}
.use-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:15px}
.use-card{padding:18px;border-radius:17px}
.use-card h4{margin:8px 0 5px}
.use-card p{font-size:12px;color:var(--muted);line-height:1.5}
.task-toolbar{display:grid;grid-template-columns:1.3fr .7fr .7fr auto;gap:9px;margin-bottom:15px}
.task-list{display:grid;gap:10px}
.task-card{
    padding:16px;border-radius:17px;display:grid;grid-template-columns:1fr auto;gap:12px;
    border-left:3px solid var(--blue);
}
.task-card.done{border-left-color:var(--green);opacity:.8}
.task-card.overdue{border-left-color:var(--red)}
.task-title{font-weight:900}
.task-meta{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}
.tag{font-size:10px;padding:5px 8px;border-radius:20px;background:rgba(255,255,255,.06);color:var(--muted)}
.tag.high{color:#ff9aa4;background:rgba(255,93,108,.08)}
.tag.medium{color:#ffd28c;background:rgba(255,184,77,.08)}
.tag.low{color:#8df1bf;background:rgba(39,223,139,.08)}
.task-actions{display:flex;gap:5px;align-items:center}
.icon-btn{border:1px solid var(--border);background:rgba(255,255,255,.04);color:#cfe0f5;border-radius:9px;padding:8px}
.empty{padding:45px;text-align:center;color:var(--muted)}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.form-grid .wide{grid-column:1/-1}
.modal{
    position:fixed;inset:0;background:rgba(0,0,0,.65);display:none;place-items:center;z-index:100;padding:20px;
}
.modal.open{display:grid}
.modal-box{width:min(600px,100%);padding:25px;border-radius:22px}
.modal-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}
.toast{
    position:fixed;right:25px;bottom:25px;z-index:200;
    padding:14px 17px;border-radius:13px;background:#10233b;border:1px solid var(--border);
    box-shadow:var(--shadow);display:none
}
.toast.show{display:block}
@media(max-width:1050px){
    .stats-grid{grid-template-columns:repeat(3,1fr)}
    .dashboard-grid{grid-template-columns:1fr}
}
@media(max-width:800px){
    .hero{grid-template-columns:1fr;padding:50px 0}
    .hero-card{display:none}
    .features{grid-template-columns:1fr;margin-top:0}
    .auth-wrap{grid-template-columns:1fr}
    .auth-info{display:none}
    .sidebar{width:78px;padding:15px 9px}
    .side-brand span,.side-nav button span,.profile-info{display:none}
    .side-brand{justify-content:center}
    .side-nav button{justify-content:center}
    .profile{justify-content:center}
    .main{margin-left:78px;padding:18px}
    .stats-grid{grid-template-columns:repeat(2,1fr)}
    .use-grid{grid-template-columns:1fr}
    .task-toolbar{grid-template-columns:1fr 1fr}
}
@media(max-width:520px){
    .navbar{padding:16px 0}
    .nav-actions .btn:first-child{display:none}
    .hero h1{letter-spacing:-2px}
    .hero p{font-size:15px}
    .auth-form{padding:28px 20px}
    .stats-grid{grid-template-columns:1fr 1fr}
    .topbar{align-items:flex-start}
    .top-actions{display:none}
    .form-grid{grid-template-columns:1fr}
    .form-grid .wide{grid-column:auto}
}
</style>
</head>
<body>

<!-- =========================
     FRONT PAGE
========================= -->
<section id="frontPage" class="page">
    <div class="grid-bg"></div>

    <nav class="navbar">
        <div class="brand">
            <div class="brand-mark">✓</div>
            <span>TaskFlow</span>
        </div>
        <div class="nav-actions">
            <button class="btn" onclick="showAuth('login')">Login</button>
            <button class="btn btn-primary" onclick="showAuth('signup')">Get Started</button>
        </div>
    </nav>

    <div class="hero">
        <div>
            <span class="badge">✦ Smart Daily Task Management System</span>
            <h1>Organize your work.<br><span class="gradient-text">Complete your goals.</span></h1>
            <p>
                TaskFlow is a professional task management system for organizing daily work,
                tracking deadlines, managing priorities, monitoring progress and understanding
                productivity from one simple dashboard.
            </p>
            <div class="hero-buttons">
                <button class="btn btn-primary" onclick="showAuth('signup')">Start Managing Tasks →</button>
                <button class="btn" onclick="showAuth('login')">I Already Have an Account</button>
            </div>
        </div>

        <div class="hero-card glass">
            <div class="mock-head">
                <div>
                    <div class="mock-title">Today's Productivity</div>
                    <small style="color:var(--muted)">TaskFlow overview</small>
                </div>
                <div class="dot"></div>
            </div>
            <div class="mock-stats">
                <div class="mini-stat"><b>12</b><span>Total Tasks</span></div>
                <div class="mini-stat"><b>7</b><span>Completed</span></div>
                <div class="mini-stat"><b>3</b><span>Working</span></div>
                <div class="mini-stat"><b>2</b><span>Pending</span></div>
            </div>
            <div class="mock-progress">
                <div style="display:flex;justify-content:space-between">
                    <span>Daily progress</span><b>74%</b>
                </div>
                <div class="progress-track"><div class="progress-fill"></div></div>
            </div>
        </div>
    </div>

    <div class="features">
        <div class="feature glass">
            <div class="feature-icon">📝</div>
            <h3>Create & Organize</h3>
            <p>Create tasks with categories, priorities, deadlines and descriptions.</p>
        </div>
        <div class="feature glass">
            <div class="feature-icon">📊</div>
            <h3>Track Progress</h3>
            <p>Move tasks from To-Do to Working and Completed while monitoring progress.</p>
        </div>
        <div class="feature glass">
            <div class="feature-icon">⏰</div>
            <h3>Manage Deadlines</h3>
            <p>Identify overdue work and keep important activities visible.</p>
        </div>
    </div>
</section>

<!-- =========================
     LOGIN / SIGNUP PAGE
========================= -->
<section id="authPage" class="page">
    <div class="auth-wrap glass">
        <div class="auth-info">
            <div class="brand"><div class="brand-mark">✓</div><span>TaskFlow</span></div>
            <h2 id="authHeroTitle">Welcome back.</h2>
            <p id="authHeroText">
                Sign in to continue managing your tasks, deadlines and daily productivity.
            </p>
            <div class="auth-list">
                <div><span class="check">✓</span> Daily task organization</div>
                <div><span class="check">✓</span> Priority and deadline tracking</div>
                <div><span class="check">✓</span> Productivity analytics</div>
                <div><span class="check">✓</span> Browser Local Storage persistence</div>
            </div>
            <button class="btn" style="margin-top:28px" onclick="showFront()">← Back to Front Page</button>
        </div>

        <div class="auth-form">
            <h2 id="authTitle">Login to TaskFlow</h2>
            <p class="sub" id="authSub">Use your TaskFlow account to open the dashboard.</p>

            <form id="authForm">
                <div class="form-group" id="nameGroup" style="display:none">
                    <label>Full Name</label>
                    <input id="signupName" type="text" placeholder="Enter your name">
                </div>

                <div class="form-group">
                    <label>Username</label>
                    <input id="username" type="text" placeholder="Enter username" autocomplete="username">
                </div>

                <div class="form-group">
                    <label>Password</label>
                    <div class="password-box">
                        <input id="password" type="password" placeholder="Enter password" autocomplete="current-password">
                        <button type="button" onclick="togglePassword()">Show</button>
                    </div>
                </div>

                <div class="form-group" id="confirmGroup" style="display:none">
                    <label>Confirm Password</label>
                    <input id="confirmPassword" type="password" placeholder="Confirm password">
                </div>

                <div class="auth-row" id="loginOptions">
                    <label><input id="remember" type="checkbox"> Remember username</label>
                    <span class="link" onclick="forgotPassword()">Forgot password?</span>
                </div>

                <div class="error" id="authError"></div>

                <button class="btn btn-primary full-btn" id="authSubmit" type="submit">Sign In</button>
            </form>

            <div class="demo" id="demoBox">
                <b>College Demo Account</b><br>
                Username: <b>kamal</b> &nbsp; Password: <b>1234</b>
            </div>

            <div style="text-align:center;margin-top:18px;color:var(--muted);font-size:12px">
                <span id="switchText">New to TaskFlow?</span>
                <span class="link" id="switchLink" onclick="toggleAuthMode()"> Create account</span>
            </div>
        </div>
    </div>
</section>

<!-- =========================
     MAIN APPLICATION
========================= -->
<section id="appPage" class="page">
    <aside class="sidebar">
        <div class="side-brand">
            <div class="brand-mark">✓</div><span>TaskFlow</span>
        </div>

        <div class="side-nav">
            <button class="active" onclick="openSection('dashboard',this)"><div class="nav-icon">🏠</div><span>Dashboard</span></button>
            <button onclick="openSection('todo',this)"><div class="nav-icon">📋</div><span>To-Do</span></button>
            <button onclick="openSection('working',this)"><div class="nav-icon">⚙️</div><span>Working</span></button>
            <button onclick="openSection('completed',this)"><div class="nav-icon">✅</div><span>Completed</span></button>
            <button onclick="openAddTask()"><div class="nav-icon">➕</div><span>Add Task</span></button>
            <button onclick="openSection('analytics',this)"><div class="nav-icon">📊</div><span>Analytics</span></button>
            <button onclick="logoutTaskFlow()"><div class="nav-icon">🚪</div><span>Logout</span></button>
        </div>

        <div class="profile">
            <div class="avatar" id="profileAvatar">K</div>
            <div class="profile-info">
                <div class="profile-name" id="profileName">Kamal</div>
                <div class="profile-role">TaskFlow User</div>
            </div>
        </div>
    </aside>

    <main class="main">
        <div class="topbar">
            <div class="page-title">
                <h1 id="sectionTitle">Dashboard</h1>
                <p id="dateText"></p>
            </div>
            <div class="top-actions">
                <button class="btn" onclick="openAddTask()">＋ Add Task</button>
                <button class="btn btn-primary" onclick="openSection('analytics')">View Analytics</button>
            </div>
        </div>

        <!-- DASHBOARD -->
        <div id="dashboard" class="content-section active">
            <div class="welcome glass">
                <h2 id="welcomeTitle">Welcome to TaskFlow 👋</h2>
                <p>
                    Manage your daily life, academic work, projects, deadlines and personal goals
                    from one organized workspace.
                </p>
            </div>

            <div class="stats-grid">
                <div class="stat glass blue"><small>Total Tasks</small><strong id="totalStat">0</strong></div>
                <div class="stat glass orange"><small>Pending</small><strong id="pendingStat">0</strong></div>
                <div class="stat glass purple"><small>Working</small><strong id="workingStat">0</strong></div>
                <div class="stat glass green"><small>Completed</small><strong id="completedStat">0</strong></div>
                <div class="stat glass red"><small>Overdue</small><strong id="overdueStat">0</strong></div>
            </div>

            <div class="dashboard-grid">
                <div class="panel glass">
                    <div class="panel-head"><h3>Weekly Task Activity</h3><span style="color:var(--muted);font-size:11px">Live data</span></div>
                    <div class="chart" id="activityChart"></div>
                </div>
                <div class="panel glass">
                    <div class="panel-head"><h3>Overall Progress</h3><span id="progressPercent">0%</span></div>
                    <div class="progress-big"><div id="overallProgress"></div></div>
                    <p style="color:var(--muted);font-size:12px;line-height:1.6" id="progressText">Add tasks to begin tracking productivity.</p>
                </div>
            </div>

            <div class="panel glass" style="margin-top:15px">
                <div class="panel-head"><h3>Daily-Life Uses</h3></div>
                <div class="use-grid">
                    <div class="use-card" style="background:rgba(77,163,255,.06)"><div>🎓</div><h4>College</h4><p>Assignments, lab work, exams, projects and study plans.</p></div>
                    <div class="use-card" style="background:rgba(149,104,255,.06)"><div>💼</div><h4>Work</h4><p>Meetings, reports, project activities and deadlines.</p></div>
                    <div class="use-card" style="background:rgba(39,223,139,.06)"><div>🏠</div><h4>Personal Life</h4><p>Shopping, exercise, appointments and everyday responsibilities.</p></div>
                </div>
            </div>
        </div>

        <!-- TASK SECTIONS -->
        <div id="todo" class="content-section">
            <div class="panel glass">
                <div class="panel-head"><h3>To-Do Tasks</h3><button class="btn btn-primary" onclick="openAddTask()">＋ Add Task</button></div>
                <div class="task-toolbar">
                    <input id="todoSearch" placeholder="Search tasks..." oninput="renderTasks('todo')">
                    <select id="todoPriority" onchange="renderTasks('todo')"><option value="all">All priorities</option><option>High</option><option>Medium</option><option>Low</option></select>
                    <select id="todoCategory" onchange="renderTasks('todo')"><option value="all">All categories</option><option>College</option><option>Work</option><option>Personal</option><option>Health</option><option>Other</option></select>
                    <button class="btn" onclick="clearFilters('todo')">Reset</button>
                </div>
                <div class="task-list" id="todoList"></div>
            </div>
        </div>

        <div id="working" class="content-section">
            <div class="panel glass">
                <div class="panel-head"><h3>Working Tasks</h3><button class="btn btn-primary" onclick="openAddTask()">＋ Add Task</button></div>
                <div class="task-list" id="workingList"></div>
            </div>
        </div>

        <div id="completed" class="content-section">
            <div class="panel glass">
                <div class="panel-head"><h3>Completed Tasks</h3></div>
                <div class="task-list" id="completedList"></div>
            </div>
        </div>

        <!-- ANALYTICS -->
        <div id="analytics" class="content-section">
            <div class="dashboard-grid">
                <div class="panel glass">
                    <div class="panel-head"><h3>Task Distribution</h3></div>
                    <div class="chart" id="analyticsChart"></div>
                </div>
                <div class="panel glass">
                    <div class="panel-head"><h3>Productivity Summary</h3></div>
                    <div id="analyticsSummary" style="display:grid;gap:13px"></div>
                </div>
            </div>
        </div>
    </main>
</section>

<!-- ADD/EDIT MODAL -->
<div class="modal" id="taskModal">
    <div class="modal-box glass">
        <div class="modal-head">
            <h3 id="modalTitle">Add New Task</h3>
            <button class="icon-btn" onclick="closeTaskModal()">✕</button>
        </div>

        <form id="taskForm">
            <div class="form-grid">
                <div class="wide">
                    <label>Task Title</label>
                    <input id="taskTitle" required placeholder="Example: Complete Java assignment">
                </div>
                <div>
                    <label>Category</label>
                    <select id="taskCategory">
                        <option>College</option><option>Work</option><option>Personal</option><option>Health</option><option>Other</option>
                    </select>
                </div>
                <div>
                    <label>Priority</label>
                    <select id="taskPriority"><option>High</option><option selected>Medium</option><option>Low</option></select>
                </div>
                <div>
                    <label>Deadline</label>
                    <input id="taskDeadline" type="date">
                </div>
                <div>
                    <label>Status</label>
                    <select id="taskStatus"><option>To-Do</option><option>Working</option><option>Completed</option></select>
                </div>
                <div class="wide">
                    <label>Description</label>
                    <textarea id="taskDescription" rows="4" placeholder="Add task details..."></textarea>
                </div>
            </div>
            <button class="btn btn-primary full-btn" style="margin-top:18px" type="submit">Save Task</button>
        </form>
    </div>
</div>

<div class="toast" id="toast"></div>

<script>
/* =========================================
   APPLICATION STATE
========================================= */
let authMode = "login";
let editingTaskId = null;
let tasks = JSON.parse(localStorage.getItem("taskflowTasks") || "[]");

/* =========================================
   FRONT / AUTH NAVIGATION
========================================= */
function showFront(){
    document.getElementById("frontPage").style.display="block";
    document.getElementById("authPage").style.display="none";
    document.getElementById("appPage").style.display="none";
    window.scrollTo(0,0);
}
function showAuth(mode="login"){
    authMode=mode;
    document.getElementById("frontPage").style.display="none";
    document.getElementById("appPage").style.display="none";
    document.getElementById("authPage").style.display="grid";
    setAuthMode(mode);
}
function setAuthMode(mode){
    authMode=mode;
    const signup=mode==="signup";
    document.getElementById("authTitle").textContent=signup?"Create your TaskFlow account":"Login to TaskFlow";
    document.getElementById("authSub").textContent=signup?"Create an account to start organizing your daily tasks.":"Use your TaskFlow account to open the dashboard.";
    document.getElementById("authHeroTitle").textContent=signup?"Build your organized day.":"Welcome back.";
    document.getElementById("authHeroText").textContent=signup?"Create your account and manage college, work and personal tasks from one place.":"Sign in to continue managing your tasks, deadlines and daily productivity.";
    document.getElementById("nameGroup").style.display=signup?"block":"none";
    document.getElementById("confirmGroup").style.display=signup?"block":"none";
    document.getElementById("loginOptions").style.display=signup?"none":"flex";
    document.getElementById("authSubmit").textContent=signup?"Create Account":"Sign In";
    document.getElementById("demoBox").style.display=signup?"none":"block";
    document.getElementById("switchText").textContent=signup?"Already have an account?":"New to TaskFlow?";
    document.getElementById("switchLink").textContent=signup?" Login":" Create account";
    document.getElementById("authError").textContent="";
}
function toggleAuthMode(){setAuthMode(authMode==="login"?"signup":"login")}
function togglePassword(){
    const p=document.getElementById("password");
    const b=p.parentElement.querySelector("button");
    p.type=p.type==="password"?"text":"password";
    b.textContent=p.type==="password"?"Show":"Hide";
}
function forgotPassword(){
    document.getElementById("authError").style.color="#9db0c8";
    document.getElementById("authError").textContent="Demo account: username kamal, password 1234.";
}

/* =========================================
   AUTHENTICATION
========================================= */
document.getElementById("authForm").addEventListener("submit",function(e){
    e.preventDefault();
    const user=document.getElementById("username").value.trim();
    const pass=document.getElementById("password").value;
    const error=document.getElementById("authError");

    if(authMode==="signup"){
        const name=document.getElementById("signupName").value.trim();
        const confirm=document.getElementById("confirmPassword").value;
        if(!name||!user||!pass){error.textContent="Please fill all required fields.";return}
        if(pass.length<4){error.textContent="Password must contain at least 4 characters.";return}
        if(pass!==confirm){error.textContent="Passwords do not match.";return}

        const users=JSON.parse(localStorage.getItem("taskflowUsers")||"[]");
        if(users.some(x=>x.username===user)){error.textContent="Username already exists.";return}
        users.push({name,username:user,password:pass});
        localStorage.setItem("taskflowUsers",JSON.stringify(users));
        loginSuccess({name,username:user});
        return;
    }

    const users=JSON.parse(localStorage.getItem("taskflowUsers")||"[]");
    const registered=users.find(x=>x.username===user&&x.password===pass);
    const demo=(user==="kamal"&&pass==="1234");

    if(demo) loginSuccess({name:"Kamal",username:user});
    else if(registered) loginSuccess(registered);
    else error.textContent="Invalid username or password.";
});

function loginSuccess(user){
    localStorage.setItem("taskflowLoggedIn","true");
    localStorage.setItem("taskflowUser",JSON.stringify(user));
    localStorage.setItem("taskflowLoginTime",new Date().toISOString());

    if(document.getElementById("remember").checked){
        localStorage.setItem("taskflowRememberUser",user.username);
    }

    openApp(user);
}
function openApp(user){
    document.getElementById("frontPage").style.display="none";
    document.getElementById("authPage").style.display="none";
    document.getElementById("appPage").style.display="block";

    const name=user.name||user.username||"User";
    document.getElementById("profileName").textContent=name;
    document.getElementById("profileAvatar").textContent=name.charAt(0).toUpperCase();
    document.getElementById("welcomeTitle").textContent="Welcome, "+name+" 👋";
    updateDate();
    refreshAll();
    showToast("Login successful. Welcome to TaskFlow!");
}
function logoutTaskFlow(){
    localStorage.removeItem("taskflowLoggedIn");
    localStorage.removeItem("taskflowUser");
    localStorage.removeItem("taskflowLoginTime");
    showAuth("login");
    const saved=localStorage.getItem("taskflowRememberUser");
    if(saved)document.getElementById("username").value=saved;
    showToast("You have been logged out.");
}

/* =========================================
   SECTION NAVIGATION
========================================= */
function openSection(id,btn){
    document.querySelectorAll(".content-section").forEach(x=>x.classList.remove("active"));
    document.getElementById(id).classList.add("active");
    document.querySelectorAll(".side-nav button").forEach(x=>x.classList.remove("active"));
    if(btn)btn.classList.add("active");
    const titles={dashboard:"Dashboard",todo:"To-Do Tasks",working:"Working Tasks",completed:"Completed Tasks",analytics:"Analytics"};
    document.getElementById("sectionTitle").textContent=titles[id]||"TaskFlow";
    refreshAll();
}

/* =========================================
   TASK MODAL
========================================= */
function openAddTask(){
    editingTaskId=null;
    document.getElementById("modalTitle").textContent="Add New Task";
    document.getElementById("taskForm").reset();
    document.getElementById("taskStatus").value="To-Do";
    document.getElementById("taskModal").classList.add("open");
}
function closeTaskModal(){document.getElementById("taskModal").classList.remove("open")}
document.getElementById("taskForm").addEventListener("submit",function(e){
    e.preventDefault();
    const task={
        id:editingTaskId||Date.now().toString(),
        title:document.getElementById("taskTitle").value.trim(),
        category:document.getElementById("taskCategory").value,
        priority:document.getElementById("taskPriority").value,
        deadline:document.getElementById("taskDeadline").value,
        status:document.getElementById("taskStatus").value,
        description:document.getElementById("taskDescription").value.trim(),
        createdAt:editingTaskId?(tasks.find(x=>x.id===editingTaskId)?.createdAt||new Date().toISOString()):new Date().toISOString()
    };
    if(editingTaskId){
        tasks=tasks.map(x=>x.id===editingTaskId?task:x);
        showToast("Task updated.");
    }else{
        tasks.unshift(task);
        showToast("Task added.");
    }
    saveTasks();
    closeTaskModal();
    refreshAll();
});
function editTask(id){
    const t=tasks.find(x=>x.id===id);if(!t)return;
    editingTaskId=id;
    document.getElementById("modalTitle").textContent="Edit Task";
    document.getElementById("taskTitle").value=t.title;
    document.getElementById("taskCategory").value=t.category;
    document.getElementById("taskPriority").value=t.priority;
    document.getElementById("taskDeadline").value=t.deadline;
    document.getElementById("taskStatus").value=t.status;
    document.getElementById("taskDescription").value=t.description||"";
    document.getElementById("taskModal").classList.add("open");
}
function deleteTask(id){
    if(!confirm("Delete this task?"))return;
    tasks=tasks.filter(x=>x.id!==id);
    saveTasks();refreshAll();showToast("Task deleted.");
}
function setTaskStatus(id,status){
    tasks=tasks.map(x=>x.id===id?{...x,status}:x);
    saveTasks();refreshAll();showToast("Task status updated.");
}
function saveTasks(){localStorage.setItem("taskflowTasks",JSON.stringify(tasks))}

/* =========================================
   TASK RENDERING
========================================= */
function isOverdue(t){
    if(!t.deadline||t.status==="Completed")return false;
    const end=new Date(t.deadline+"T23:59:59");
    return end<new Date();
}
function escapeHTML(str){
    return String(str||"").replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[m]));
}
function taskCard(t){
    const overdue=isOverdue(t);
    const p=t.priority.toLowerCase();
    return `
    <div class="task-card ${t.status==="Completed"?"done":""} ${overdue?"overdue":""}">
        <div>
            <div class="task-title">${escapeHTML(t.title)}</div>
            <div style="font-size:12px;color:var(--muted);margin-top:5px">${escapeHTML(t.description||"No description")}</div>
            <div class="task-meta">
                <span class="tag">${escapeHTML(t.category)}</span>
                <span class="tag ${p}">${escapeHTML(t.priority)}</span>
                <span class="tag">${t.deadline?"📅 "+t.deadline:"No deadline"}</span>
                ${overdue?'<span class="tag high">OVERDUE</span>':""}
            </div>
        </div>
        <div class="task-actions">
            <button class="icon-btn" onclick="editTask('${t.id}')">✏️</button>
            ${t.status!=="Completed"?`<button class="icon-btn" onclick="setTaskStatus('${t.id}','${t.status==="To-Do"?"Working":"Completed"}')">${t.status==="To-Do"?"▶":"✓"}</button>`:""}
            <button class="icon-btn" onclick="deleteTask('${t.id}')">🗑️</button>
        </div>
    </div>`;
}
function renderTasks(type){
    let list=[];
    if(type==="todo"){
        const search=(document.getElementById("todoSearch")?.value||"").toLowerCase();
        const priority=document.getElementById("todoPriority")?.value||"all";
        const category=document.getElementById("todoCategory")?.value||"all";
        list=tasks.filter(t=>t.status==="To-Do");
        if(search)list=list.filter(t=>(t.title+" "+t.description).toLowerCase().includes(search));
        if(priority!=="all")list=list.filter(t=>t.priority===priority);
        if(category!=="all")list=list.filter(t=>t.category===category);
    }
    if(type==="working")list=tasks.filter(t=>t.status==="Working");
    if(type==="completed")list=tasks.filter(t=>t.status==="Completed");

    const el=document.getElementById(type+"List");
    if(!list.length){
        el.innerHTML='<div class="empty">No tasks found. Add a task to get started.</div>';
        return;
    }
    el.innerHTML=list.map(taskCard).join("");
}
function clearFilters(){
    document.getElementById("todoSearch").value="";
    document.getElementById("todoPriority").value="all";
    document.getElementById("todoCategory").value="all";
    renderTasks("todo");
}

/* =========================================
   DASHBOARD STATISTICS
========================================= */
function refreshAll(){
    tasks=JSON.parse(localStorage.getItem("taskflowTasks")||"[]");
    const total=tasks.length;
    const pending=tasks.filter(t=>t.status==="To-Do").length;
    const working=tasks.filter(t=>t.status==="Working").length;
    const completed=tasks.filter(t=>t.status==="Completed").length;
    const overdue=tasks.filter(isOverdue).length;

    document.getElementById("totalStat").textContent=total;
    document.getElementById("pendingStat").textContent=pending;
    document.getElementById("workingStat").textContent=working;
    document.getElementById("completedStat").textContent=completed;
    document.getElementById("overdueStat").textContent=overdue;

    const percent=total?Math.round(completed/total*100):0;
    document.getElementById("progressPercent").textContent=percent+"%";
    document.getElementById("overallProgress").style.width=percent+"%";
    document.getElementById("progressText").textContent=total
      ? `${completed} of ${total} tasks completed. Keep moving your work forward.`
      : "Add tasks to begin tracking productivity.";

    renderTasks("todo");renderTasks("working");renderTasks("completed");
    renderActivityChart();
    renderAnalytics();
}
function renderActivityChart(){
    const el=document.getElementById("activityChart");
    if(!el)return;
    const days=["Mon","Tue","Wed","Thu","Fri","Sat","Sun"];
    const values=days.map((_,i)=>{
        const d=new Date();d.setDate(d.getDate()-(6-i));
        return tasks.filter(t=>new Date(t.createdAt).toDateString()===d.toDateString()).length;
    });
    const max=Math.max(...values,1);
    el.innerHTML=values.map((v,i)=>`
      <div class="bar-wrap">
        <div class="bar" style="height:${Math.max(8,(v/max)*85)}%"></div>
        <span>${days[i]}</span>
      </div>`).join("");
}
function renderAnalytics(){
    const el=document.getElementById("analyticsChart");
    if(!el)return;
    const values=[
      ["To-Do",tasks.filter(t=>t.status==="To-Do").length],
      ["Working",tasks.filter(t=>t.status==="Working").length],
      ["Done",tasks.filter(t=>t.status==="Completed").length],
      ["Overdue",tasks.filter(isOverdue).length]
    ];
    const max=Math.max(...values.map(x=>x[1]),1);
    el.innerHTML=values.map(x=>`
      <div class="bar-wrap">
        <div class="bar" style="height:${Math.max(8,(x[1]/max)*85)}%"></div>
        <span>${x[0]} (${x[1]})</span>
      </div>`).join("");

    const total=tasks.length;
    const completed=tasks.filter(t=>t.status==="Completed").length;
    const high=tasks.filter(t=>t.priority==="High").length;
    document.getElementById("analyticsSummary").innerHTML=`
      <div class="mini-stat"><span>Total tasks</span><b>${total}</b></div>
      <div class="mini-stat"><span>Completion rate</span><b>${total?Math.round(completed/total*100):0}%</b></div>
      <div class="mini-stat"><span>High priority</span><b>${high}</b></div>
      <div class="mini-stat"><span>Overdue</span><b>${tasks.filter(isOverdue).length}</b></div>`;
}
function updateDate(){
    document.getElementById("dateText").textContent=new Date().toLocaleDateString(undefined,{
        weekday:"long",year:"numeric",month:"long",day:"numeric"
    });
}

/* =========================================
   TOAST
========================================= */
let toastTimer;
function showToast(message){
    const t=document.getElementById("toast");
    t.textContent=message;t.classList.add("show");
    clearTimeout(toastTimer);
    toastTimer=setTimeout(()=>t.classList.remove("show"),2200);
}

/* =========================================
   STARTUP
========================================= */
(function init(){
    const remembered=localStorage.getItem("taskflowRememberUser");
    if(remembered)document.getElementById("username").value=remembered;

    if(localStorage.getItem("taskflowLoggedIn")==="true"){
        let user;
        try{user=JSON.parse(localStorage.getItem("taskflowUser")||"{}")}catch(e){user={}}
        openApp(user);
    }else{
        showFront();
    }

    document.getElementById("password").addEventListener("keydown",e=>{
        if(e.key==="Enter")document.getElementById("authForm").requestSubmit();
    });

    window.addEventListener("keydown",e=>{
        if(e.key==="Escape")closeTaskModal();
    });
})();
</script>
</body>
</html>
